# Build context is the repo root (images need backend/ or frontend/ plus config/).
# Never send models, uploads or databases: data/ alone is many gigabytes.
# A leading "/" anchors an entry to the repo root, so /scripts/ (setup and smoke tests) does not match
# frontend/scripts/ (copy-vad-assets.mjs, which the frontend build runs as `prebuild`).
/data/
.git/
.github/
/docs/
/scripts/
**/node_modules/
**/.next/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/*.tsbuildinfo
frontend/next-env.d.ts
frontend/AGENTS.md
# Copied from node_modules by the build (prebuild); a stale host copy must not stand in for it.
frontend/public/vad/
.env
.env.*
**/.DS_Store
